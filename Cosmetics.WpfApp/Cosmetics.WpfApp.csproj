<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<!-- 1. Tham chiếu đến ApplicationCore và Infrastructure -->
	<ItemGroup>
		<ProjectReference Include="..\Cosmetics.ApplicationCore\Cosmetics.ApplicationCore.csproj" />
		<ProjectReference Include="..\Cosmetics.Infrastructure\Cosmetics.Infrastructure.csproj" />
	</ItemGroup>

	<!-- 2. Thư viện kết nối SQL Server và Dependency Injection -->
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
	</ItemGroup>

</Project>