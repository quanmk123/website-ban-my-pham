<Window x:Class="Cosmetics.WpfApp.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Đơn Hàng - BeautyStore"
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FD"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D4788C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E2E8F0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOrderTitle" Text="Đơn Hàng #00" FontSize="18" FontWeight="Bold" Foreground="#1E1E2F"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtOrderDate" Text="Ngày đặt: ..." FontSize="11" Foreground="#718096" Margin="28,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentStatusBadge" Text="Chờ xác nhận" FontWeight="Bold" Foreground="#4F46E5" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- THÔNG TIN KHÁCH HÀNG & GIAO HÀNG -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN KHÁCH HÀNG" FontSize="11" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtCustomerName" Text="Tên: ..." FontWeight="SemiBold" FontSize="13" Foreground="#2D3748" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtCustomerPhone" Text="SĐT: ..." FontSize="12" Foreground="#4A5568" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtPaymentMethod" Text="Thanh toán: COD" FontSize="12" Foreground="#4A5568"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="ĐỊA CHỈ NHẬN HÀNG" FontSize="11" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtCustomerAddress" Text="Địa chỉ: ..." FontSize="12" Foreground="#4A5568" TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtOrderNote" Text="Ghi chú: ..." FontSize="11" Foreground="#718096" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DANH SÁCH SẢN PHẨM TRONG ĐƠN -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
            <DataGrid x:Name="DgOrderItems" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding CatalogItemId}" Width="60"/>
                    <DataGridTextColumn Header="Tên Mỹ Phẩm" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Đơn Giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0} ₫}" Width="110"/>
                    <DataGridTextColumn Header="SL" Binding="{Binding Units}" Width="50"/>
                    <DataGridTextColumn Header="Thành Tiền" Binding="{Binding Subtotal, StringFormat={}{0:N0} ₫}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- THANH ĐIỀU KHIỂN & ĐỔI TRẠNG THÁI -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Đổi trạng thái -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái đơn: " VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    <ComboBox x:Name="CboStatus" Width="170" Padding="8,6" Margin="8,0,10,0">
                        <ComboBoxItem Content="Chờ xác nhận (Pending)" Tag="0"/>
                        <ComboBoxItem Content="Đã xác nhận (Confirmed)" Tag="1"/>
                        <ComboBoxItem Content="Đang giao hàng (Shipping)" Tag="2"/>
                        <ComboBoxItem Content="Hoàn thành (Completed)" Tag="3"/>
                        <ComboBoxItem Content="Đã hủy (Cancelled)" Tag="4"/>
                    </ComboBox>
                    <Button Content="💾 Lưu Trạng Thái" Click="BtnSaveStatus_Click" 
                            Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF" FontWeight="Bold" 
                            BorderThickness="0" Padding="12,7" Cursor="Hand"/>
                </StackPanel>

                <!-- Tổng tiền & nút đóng -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                        <TextBlock Text="TỔNG TIỀN ĐƠN:" FontSize="10" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtTotalAmount" Text="0 ₫" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Đóng" Click="BtnClose_Click" 
                            Background="#EDF2F7" Foreground="#4A5568" FontWeight="SemiBold" 
                            BorderThickness="0" Padding="18,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

