<Window x:Class="Cosmetics.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BeautyStore - Hệ Thống Quản Lý &amp; Bán Hàng Mỹ Phẩm"
        Height="780" Width="1280"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Bảng màu chủ đạo -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D4788C"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#B85D71"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#1E1E2F"/>
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2A2A40"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#2D3436"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E9F2"/>

        <!-- Style cho Button Sidebar -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0B2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A40"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Card thống kê -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.05" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: SIDEBAR ĐIỀU HƯỚNG ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO THƯƠNG HIỆU -->
                <StackPanel Grid.Row="0" Margin="20,25,20,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌸" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Beauty" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Store" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="HỆ THỐNG MỸ PHẨM CHÍNH HÃNG" FontSize="10" FontWeight="SemiBold" Foreground="#8A8A9E" Margin="0,5,0,0"/>
                    <Separator Background="#2A2A40" Margin="0,15,0,5"/>
                </StackPanel>

                <!-- MENU CÁC TAB -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="DANH MỤC LÀM VIỆC" FontSize="11" FontWeight="Bold" Foreground="#6C6C82" Margin="20,10,0,8"/>
                    
                    <Button x:Name="BtnNavDashboard" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Tổng quan (Dashboard)"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavPos" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" Tag="Pos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛍️" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Bán hàng tại quầy (POS)"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavProducts" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" Tag="Products">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Kho hàng (Sản phẩm)"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavOrders" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" Tag="Orders">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Quản lý đơn hàng"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- FOOTER SIDEBAR: TÀI KHOẢN & LÀM MỚI -->
                <Border Grid.Row="2" Background="#181824" Padding="15" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quản trị viên" FontSize="11" Foreground="#A0A0B2"/>
                            <TextBlock Text="admin@beauty.com" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄" ToolTip="Làm mới dữ liệu CSDL" Click="BtnRefreshAll_Click" 
                                Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="16" Cursor="Hand" Padding="5"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= CỘT PHẢI: VÙNG NỘI DUNG CHÍNH ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- THANH TOPBAR TIÊU ĐỀ -->
            <Border Grid.Row="0" Background="#FFFFFF" Padding="25,18" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtPageTitle" Text="Tổng quan Cửa hàng" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                        <TextBlock x:Name="TxtPageSubtitle" Text="Theo dõi doanh thu, số lượng đơn hàng và tình trạng kho mỹ phẩm" FontSize="12" Foreground="#8A8A9E" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E8F8F0" CornerRadius="15" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="SQL Server LocalDB Kết Nối" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VÙNG NỘI DUNG TAB -->
            <Grid Grid.Row="1" Margin="20">

                <!-- 1. TAB DASHBOARD -->
                <Grid x:Name="TabDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 4 THẺ THỐNG KÊ KPI -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Doanh thu hoàn thành -->
                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="DOANH THU HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#8A8A9E"/>
                                <TextBlock x:Name="TxtStatRevenue" Text="0 ₫" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="Từ các đơn hàng thành công" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Tổng đơn hàng -->
                        <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TỔNG ĐƠN HÀNG" FontSize="11" FontWeight="Bold" Foreground="#8A8A9E"/>
                                <TextBlock x:Name="TxtStatOrders" Text="0" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" Margin="0,8,0,0"/>
                                <TextBlock x:Name="TxtStatCompletedOrders" Text="Đã hoàn thành: 0" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Sản phẩm trong kho -->
                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="SẢN PHẨM TRONG KHO" FontSize="11" FontWeight="Bold" Foreground="#8A8A9E"/>
                                <TextBlock x:Name="TxtStatProducts" Text="0" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,8,0,0"/>
                                <TextBlock Text="Thương hiệu chính hãng" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Cảnh báo sắp hết hàng -->
                        <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CẢNH BÁO TỒN KHO" FontSize="11" FontWeight="Bold" Foreground="#8A8A9E"/>
                                <TextBlock x:Name="TxtStatLowStock" Text="0" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,8,0,0"/>
                                <TextBlock Text="Mặt hàng tồn dưới 5 sản phẩm" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- DANH SÁCH ĐƠN HÀNG GẦN ĐÂY -->
                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Đơn Hàng Mới Nhất Gần Đây" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,12"/>
                            
                            <DataGrid Grid.Row="1" x:Name="DgRecentOrders" AutoGenerateColumns="False" IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding Id}" Width="80"/>
                                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding ShipToAddress.ReceiverName}" Width="160"/>
                                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding ShipToAddress.PhoneNumber}" Width="130"/>
                                    <DataGridTextColumn Header="Phương Thức" Binding="{Binding PaymentMethod}" Width="120"/>
                                    <DataGridTextColumn Header="Tổng Tiền (VNĐ)" Binding="{Binding FormattedTotalPrice}" Width="150"/>
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusText}" Width="140"/>
                                    <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding FormattedOrderDate}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. TAB BÁN HÀNG TẠI QUẦY (POS) -->
                <Grid x:Name="TabPos" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: CHỌN MỸ PHẨM -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Ô TÌM KIẾM SẢN PHẨM -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBox x:Name="TxtPosSearch" Padding="10,8" FontSize="14" 
                                         TextChanged="TxtPosSearch_TextChanged"
                                         ToolTip="Nhập tên sản phẩm để tìm nhanh"/>
                            </Grid>

                            <!-- DANH SÁCH SẢN PHẨM DẠNG BẢNG ĐỂ CHỌN -->
                            <DataGrid Grid.Row="1" x:Name="DgPosProducts" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" MouseDoubleClick="DgPosProducts_MouseDoubleClick"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên Mỹ Phẩm" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Thương Hiệu" Binding="{Binding CatalogBrand.Name}" Width="110"/>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding CatalogType.Name}" Width="110"/>
                                    <DataGridTextColumn Header="Đơn Giá" Binding="{Binding FormattedPrice}" Width="110"/>
                                    <DataGridTextColumn Header="Tồn Kho" Binding="{Binding StockQuantity}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: HÓA ĐƠN BÁN LẺ TẠI QUẦY -->
                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🛒 Hóa Đơn Bán Lẻ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                            <!-- DANH SÁCH MÓN TRONG GIỎ HÀNG TẠI QUẦY -->
                            <DataGrid Grid.Row="1" x:Name="DgPosCart" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="45"/>
                                    <DataGridTextColumn Header="Thành Tiền" Binding="{Binding FormattedSubtotal}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- THÔNG TIN KHÁCH HÀNG -->
                            <StackPanel Grid.Row="2" Margin="0,15,0,15">
                                <TextBlock Text="Tên Khách Hàng:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPosCustomerName" Text="Khách lẻ tại quầy" Padding="8,6" Margin="0,0,0,8"/>

                                <TextBlock Text="Số Điện Thoại:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPosCustomerPhone" Text="0901234567" Padding="8,6" Margin="0,0,0,8"/>

                                <Separator Background="{StaticResource BorderLightBrush}" Margin="0,5,0,8"/>

                                <Grid>
                                    <TextBlock Text="TỔNG TIỀN PHẢI THU:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPosCartTotal" Text="0 ₫" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- CÁC NÚT THANH TOÁN & HỦY -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Xóa Hết" Click="BtnPosClearCart_Click" 
                                        Background="#F1F2F6" Foreground="#EF4444" FontWeight="SemiBold" BorderThickness="0" Padding="10" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Grid.Column="1" Content="💳 THANH TOÁN (F9)" Click="BtnPosCheckout_Click" 
                                        Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" BorderThickness="0" Padding="12" Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. TAB KHO SẢN PHẨM -->
                <Grid x:Name="TabProducts" Visibility="Collapsed">
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtProductFilter" Padding="10,8" FontSize="14" 
                                         TextChanged="TxtProductFilter_TextChanged" ToolTip="Tìm sản phẩm trong kho..."/>
                                <Button Grid.Column="1" Content="➕ Thêm Sản Phẩm Mới" Click="BtnAddProduct_Click" 
                                        Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF" FontWeight="Bold" 
                                        Padding="15,8" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgProducts" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Tên Mỹ Phẩm" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Thương Hiệu" Binding="{Binding CatalogBrand.Name}" Width="120"/>
                                    <DataGridTextColumn Header="Loại Sản Phẩm" Binding="{Binding CatalogType.Name}" Width="120"/>
                                    <DataGridTextColumn Header="Giá Bán (VNĐ)" Binding="{Binding Price, StringFormat={}{0:N0} ₫}" Width="120"/>
                                    <DataGridTextColumn Header="Giá Gốc (VNĐ)" Binding="{Binding OriginalPrice, StringFormat={}{0:N0} ₫}" Width="120"/>
                                    <DataGridTextColumn Header="Tồn Kho" Binding="{Binding StockQuantity}" Width="80"/>
                                    <DataGridTextColumn Header="Loại Da" Binding="{Binding SkinType}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. TAB QUẢN LÝ ĐƠN HÀNG -->
                <Grid x:Name="TabOrders" Visibility="Collapsed">
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Lọc trạng thái: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CboOrderStatusFilter" Width="180" Padding="8,5" SelectionChanged="CboOrderStatusFilter_SelectionChanged">
                                        <ComboBoxItem Content="-- Tất cả đơn --" IsSelected="True"/>
                                        <ComboBoxItem Content="Hoàn thành (Completed)"/>
                                        <ComboBoxItem Content="Chờ xác nhận (Pending)"/>
                                        <ComboBoxItem Content="Đang giao (Shipping)"/>
                                        <ComboBoxItem Content="Đã hủy (Cancelled)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgOrders" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding Id}" Width="80"/>
                                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding ShipToAddress.ReceiverName}" Width="160"/>
                                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding ShipToAddress.PhoneNumber}" Width="130"/>
                                    <DataGridTextColumn Header="Phương Thức" Binding="{Binding PaymentMethod}" Width="110"/>
                                    <DataGridTextColumn Header="Tổng Tiền (VNĐ)" Binding="{Binding FormattedTotalPrice}" Width="140"/>
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusText}" Width="140"/>
                                    <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding FormattedOrderDate}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
