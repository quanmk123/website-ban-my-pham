<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beauty Cosmetics Store</title>
    <meta name="description" content="Website bán mỹ phẩm chính hãng - La Roche-Posay, Innisfree, CeraVe, MAC, Anessa, Klairs" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css?v=2.5" asp-append-version="true" />
</head>
<body>
    <!-- HEADER & NAVIGATION (ViewComponent) -->
    @await Component.InvokeAsync("NavigationMenu")

    <!-- TOAST NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 text-center" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 text-center" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- MAIN CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer-section mt-5">
        <div class="container">
            <div class="row py-5">
                <div class="col-lg-4 mb-4">
                    <h5 class="mb-3"><i class="fas fa-spa text-rose me-2"></i>Beauty<span class="text-rose">Store</span></h5>
                    <p class="footer-desc">
                        Website bán mỹ phẩm chính hãng<br />
                        với các thương hiệu hàng đầu thế giới.<br />
                        Cam kết 100% sản phẩm chính hãng.
                    </p>
                    <div class="social-links">
                        <a href="#" class="me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="mb-3 fw-semibold">Danh mục</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Kem chống nắng</a></li>
                        <li><a href="#">Serum dưỡng da</a></li>
                        <li><a href="#">Nước tẩy trang</a></li>
                        <li><a href="#">Son môi</a></li>
                        <li><a href="#">Kem dưỡng ẩm</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 mb-4">
                    <h6 class="mb-3 fw-semibold">Hỗ trợ</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Chính sách vận chuyển</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 mb-4">
                    <h6 class="mb-3 fw-semibold">Liên hệ</h6>
                    <ul class="list-unstyled footer-links">
                        <li><i class="fas fa-map-marker-alt me-2 text-rose"></i>TP. Hà Nội, Việt Nam</li>
                        <li><i class="fas fa-phone me-2 text-rose"></i>1900 636 888 (8:30 - 21:30)</li>
                        <li><i class="fas fa-envelope me-2 text-rose"></i>contact@beautystore.vn</li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Cập nhật badge giỏ hàng
        async function updateBasketBadge() {
            try {
                const response = await fetch('/Basket/GetBasketItemCount');
                const data = await response.json();
                const badge = document.getElementById('basket-badge');
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) { }
        }
        updateBasketBadge();

        // Auto-dismiss alerts
        setTimeout(() => {
            document.querySelectorAll('.alert-dismissible').forEach(a => {
                new bootstrap.Alert(a).close();
            });
        }, 4000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
