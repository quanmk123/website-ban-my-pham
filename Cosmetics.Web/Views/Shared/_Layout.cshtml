<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beauty Cosmetics Store</title>
    <meta name="description" content="Website bán mỹ phẩm chính hãng - La Roche-Posay, Innisfree, CeraVe, MAC, Anessa, Klairs" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- HEADER & NAVIGATION -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="fas fa-spa text-rose me-2 fs-4"></i>
                <span class="brand-text">Beauty<span class="text-rose">Store</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalog" asp-action="Index">
                            <i class="fas fa-store me-1"></i> Sản phẩm
                        </a>
                    </li>
                </ul>
                <!-- Search bar -->
                <form class="d-flex me-3" asp-controller="Catalog" asp-action="Index" method="get">
                    <div class="input-group">
                        <input class="form-control form-control-sm border-end-0" type="search" name="searchTerm"
                               placeholder="Tìm kiếm mỹ phẩm..." value="@Context.Request.Query["searchTerm"]" />
                        <button class="btn btn-outline-rose btn-sm" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Basket" asp-action="Index">
                            <i class="fas fa-shopping-bag fs-5"></i>
                            <span id="basket-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-rose" style="display:none;">
                                0
                            </span>
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="fas fa-tachometer-alt me-2"></i>Quản trị
                                    </a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                    <i class="fas fa-receipt me-2"></i>Đơn hàng của tôi
                                </a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-rose btn-sm ms-2 mt-1" asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- TOAST NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 text-center" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 text-center" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- MAIN CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer-section mt-5">
        <div class="container">
            <div class="row py-5">
                <div class="col-lg-4 mb-4">
                    <h5 class="mb-3"><i class="fas fa-spa text-rose me-2"></i>Beauty<span class="text-rose">Store</span></h5>
                    <p class="text-muted">Website bán mỹ phẩm chính hãng với các thương hiệu hàng đầu thế giới. Cam kết 100% sản phẩm chính hãng.</p>
                    <div class="social-links">
                        <a href="#" class="me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="mb-3 fw-semibold">Danh mục</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Kem chống nắng</a></li>
                        <li><a href="#">Serum dưỡng da</a></li>
                        <li><a href="#">Nước tẩy trang</a></li>
                        <li><a href="#">Son môi</a></li>
                        <li><a href="#">Kem dưỡng ẩm</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 mb-4">
                    <h6 class="mb-3 fw-semibold">Hỗ trợ</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Chính sách vận chuyển</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 mb-4">
                    <h6 class="mb-3 fw-semibold">Liên hệ</h6>
                    <ul class="list-unstyled footer-links">
                        <li><i class="fas fa-map-marker-alt me-2 text-rose"></i>TP. Hồ Chí Minh, Việt Nam</li>
                        <li><i class="fas fa-phone me-2 text-rose"></i>0123 456 789</li>
                        <li><i class="fas fa-envelope me-2 text-rose"></i>contact@beautystore.vn</li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="text-center py-3">
                <small class="text-muted">&copy; 2024 BeautyStore - Đồ Án Tốt Nghiệp. Bảo lưu mọi quyền.</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Cập nhật badge giỏ hàng
        async function updateBasketBadge() {
            try {
                const response = await fetch('/Basket/GetBasketItemCount');
                const data = await response.json();
                const badge = document.getElementById('basket-badge');
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) { }
        }
        updateBasketBadge();

        // Auto-dismiss alerts
        setTimeout(() => {
            document.querySelectorAll('.alert-dismissible').forEach(a => {
                new bootstrap.Alert(a).close();
            });
        }, 4000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
