@model Cosmetics.Web.ViewComponents.NavigationMenuViewModel

<!-- TOP BAR - Thông tin liên hệ & hotline -->
<div class="top-bar">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="top-bar-left">
            <span><i class="fas fa-phone-alt me-1"></i> Hotline: <strong>1900 636 888</strong></span>
            <span class="mx-3 d-none d-md-inline">|</span>
            <span class="d-none d-md-inline"><i class="fas fa-envelope me-1"></i> contact@beautystore.vn</span>
        </div>
        <div class="top-bar-right d-none d-md-flex align-items-center">
            <a href="#" class="top-bar-link"><i class="fas fa-map-marker-alt me-1"></i> Hệ thống cửa hàng</a>
            <span class="mx-2">|</span>
            <a href="#" class="top-bar-link"><i class="fas fa-truck me-1"></i> Kiểm tra đơn hàng</a>
        </div>
    </div>
</div>

<!-- MAIN HEADER - Logo, Search, Icons -->
<header class="main-header">
    <div class="container d-flex align-items-center justify-content-between py-2">
        <!-- Logo -->
        <a class="header-logo d-flex align-items-center" href="/">
            <i class="fas fa-spa text-rose me-2 fs-3"></i>
            <span class="brand-text">Beauty<span class="text-rose">Store</span></span>
        </a>

        <!-- Search Bar -->
        <form class="header-search d-none d-lg-flex" asp-controller="Catalog" asp-action="Index" method="get">
            <div class="search-wrapper">
                <input class="search-input" type="search" name="searchTerm"
                       placeholder="Tìm kiếm sản phẩm, thương hiệu..." value="@Context.Request.Query["searchTerm"]" />
                <button class="search-btn" type="submit">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>

        <!-- Header Actions -->
        <div class="header-actions d-flex align-items-center">
            <!-- Mobile Search Toggle -->
            <button class="header-icon-btn d-lg-none" type="button" id="mobileSearchToggle">
                <i class="fas fa-search"></i>
            </button>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="header-icon-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-user"></i>
                        <span class="d-none d-md-inline ms-1 header-username">@User.Identity.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-2 text-rose"></i>Quản trị hệ thống
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }
                        <li>
                            <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                <i class="fas fa-receipt me-2 text-rose"></i>Đơn hàng của tôi
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt me-2 text-rose"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="header-icon-btn" asp-controller="Account" asp-action="Login" title="Đăng nhập">
                    <i class="fas fa-user"></i>
                    <span class="d-none d-md-inline ms-1">Đăng nhập</span>
                </a>
            }

            <!-- Cart -->
            <a class="header-icon-btn cart-btn position-relative" asp-controller="Basket" asp-action="Index" title="Giỏ hàng">
                <i class="fas fa-shopping-bag"></i>
                <span id="basket-badge" class="cart-badge" style="display:none;">0</span>
            </a>
        </div>
    </div>

    <!-- Mobile Search (hidden by default) -->
    <div class="mobile-search-bar d-lg-none" id="mobileSearchBar" style="display:none;">
        <div class="container py-2">
            <form asp-controller="Catalog" asp-action="Index" method="get">
                <div class="search-wrapper">
                    <input class="search-input" type="search" name="searchTerm"
                           placeholder="Tìm kiếm sản phẩm..." value="@Context.Request.Query["searchTerm"]" />
                    <button class="search-btn" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</header>

<!-- NAVIGATION BAR - Dropdown menus -->
<nav class="main-nav sticky-top">
    <div class="container">
        <div class="nav-wrapper">
            <!-- Mobile hamburger -->
            <button class="nav-hamburger d-lg-none" type="button" id="navHamburger">
                <i class="fas fa-bars"></i>
                <span class="ms-2">Danh mục</span>
            </button>

            <ul class="nav-menu" id="navMenu">
                <!-- Trang chủ -->
                <li class="nav-menu-item">
                    <a class="nav-menu-link" href="/">
                        <i class="fas fa-home me-1"></i> Trang chủ
                    </a>
                </li>

                <!-- Sản phẩm - Dropdown theo Danh mục -->
                <li class="nav-menu-item has-dropdown">
                    <a class="nav-menu-link" asp-controller="Catalog" asp-action="Index">
                        <i class="fas fa-th-large me-1"></i> Sản phẩm
                        <i class="fas fa-chevron-down ms-1 dropdown-arrow"></i>
                    </a>
                    <div class="mega-dropdown">
                        <div class="mega-dropdown-inner">
                            <div class="mega-col">
                                <h6 class="mega-title"><i class="fas fa-tags me-1"></i> Theo danh mục</h6>
                                <ul class="mega-list">
                                    <li><a asp-controller="Catalog" asp-action="Index">Tất cả sản phẩm</a></li>
                                    @foreach (var type in Model.Types)
                                    {
                                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-typeId="@type.Id">@type.Name</a></li>
                                    }
                                </ul>
                            </div>
                            <div class="mega-col">
                                <h6 class="mega-title"><i class="fas fa-leaf me-1"></i> Theo loại da</h6>
                                <ul class="mega-list">
                                    @foreach (var skin in Model.SkinTypes)
                                    {
                                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-skinType="@skin">@skin</a></li>
                                    }
                                </ul>
                            </div>
                            <div class="mega-col mega-promo">
                                <div class="mega-promo-card">
                                    <i class="fas fa-fire-alt"></i>
                                    <h6>Ưu đãi hot</h6>
                                    <p>Giảm đến 50% cho các sản phẩm chăm sóc da</p>
                                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-sm btn-rose">Xem ngay</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>

                <!-- Thương hiệu - Dropdown -->
                <li class="nav-menu-item has-dropdown">
                    <a class="nav-menu-link" asp-controller="Catalog" asp-action="Index">
                        <i class="fas fa-award me-1"></i> Thương hiệu
                        <i class="fas fa-chevron-down ms-1 dropdown-arrow"></i>
                    </a>
                    <div class="mega-dropdown">
                        <div class="mega-dropdown-inner brand-grid">
                            @foreach (var brand in Model.Brands)
                            {
                                <a class="brand-dropdown-item" asp-controller="Catalog" asp-action="Index" asp-route-brandId="@brand.Id">
                                    <i class="fas fa-gem me-2"></i>@brand.Name
                                </a>
                            }
                        </div>
                    </div>
                </li>

                <!-- Khuyến mãi -->
                <li class="nav-menu-item">
                    <a class="nav-menu-link highlight-link" asp-controller="Catalog" asp-action="Index">
                        <i class="fas fa-percent me-1"></i> Khuyến mãi
                    </a>
                </li>

                <!-- Liên hệ -->
                <li class="nav-menu-item">
                    <a class="nav-menu-link" href="#">
                        <i class="fas fa-headset me-1"></i> Liên hệ
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    // Mobile search toggle
    document.getElementById('mobileSearchToggle')?.addEventListener('click', function() {
        var bar = document.getElementById('mobileSearchBar');
        bar.style.display = bar.style.display === 'none' ? 'block' : 'none';
    });

    // Mobile nav hamburger toggle
    document.getElementById('navHamburger')?.addEventListener('click', function() {
        document.getElementById('navMenu')?.classList.toggle('nav-menu-open');
    });
</script>
