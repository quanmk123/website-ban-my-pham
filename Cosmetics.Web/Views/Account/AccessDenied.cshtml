@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="mb-4">
                    <span class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                        <i class="fas fa-lock fs-1"></i>
                    </span>
                </div>
                <h2 class="fw-bold mb-3">Truy Cập Bị Từ Chối</h2>
                <p class="text-muted mb-4">
                    Bạn không có quyền truy cập vào trang này. Khu vực này chỉ dành cho tài khoản Quản trị viên (Admin).
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-rose rounded-pill px-4">
                        <i class="fas fa-arrow-left me-2"></i>Về trang chủ
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
