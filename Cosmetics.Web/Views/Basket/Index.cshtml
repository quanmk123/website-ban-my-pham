@model Cosmetics.Web.ViewModels.BasketViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container py-5">
    <h2 class="mb-4"><i class="fas fa-shopping-bag text-rose me-2"></i>Giỏ hàng của bạn</h2>

    @if (Model.Items.Any())
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="basket-section">
                    <form asp-controller="Basket" asp-action="UpdateQuantities" method="post">
                        @Html.AntiForgeryToken()
                        @foreach (var item in Model.Items)
                        {
                            <div class="basket-item">
                                <img src="@item.PictureUri" alt="@item.ProductName"
                                     onerror="this.src='/images/placeholder.png'" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1" style="font-family:'Inter',sans-serif; font-size:0.95rem;">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.CatalogItemId"
                                           class="text-decoration-none text-dark">@item.ProductName</a>
                                    </h6>
                                    <span class="text-rose fw-semibold">@item.FormattedPrice</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="number" name="quantities[@item.Id]" value="@item.Quantity"
                                           min="0" max="99" class="quantity-input" />
                                </div>
                                <div class="ms-3 text-end" style="min-width:120px;">
                                    <strong>@item.FormattedSubtotal</strong>
                                </div>
                                <form asp-controller="Basket" asp-action="RemoveItem" method="post" class="ms-2">
                                    <input type="hidden" name="basketItemId" value="@item.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                        <div class="mt-3">
                            <button type="submit" class="btn btn-outline-rose btn-sm">
                                <i class="fas fa-sync me-2"></i>Cập nhật giỏ hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="basket-section">
                    <h5 class="mb-3">Tổng đơn hàng</h5>
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính (@Model.Items.Count sản phẩm)</span>
                        <strong>@Model.FormattedTotal</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Phí vận chuyển</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <strong class="fs-5">Tổng cộng</strong>
                        <strong class="fs-5 text-rose">@Model.FormattedTotal</strong>
                    </div>
                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-rose w-100 btn-lg">
                        <i class="fas fa-credit-card me-2"></i>Tiến hành thanh toán
                    </a>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                        <i class="fas fa-arrow-left me-2"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-shopping-bag"></i>
            <p>Giỏ hàng của bạn đang trống.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-rose mt-3">
                <i class="fas fa-store me-2"></i>Khám phá sản phẩm
            </a>
        </div>
    }
</div>
