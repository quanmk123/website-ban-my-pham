@model Cosmetics.Web.ViewModels.OrderViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <div style="width:80px;height:80px;margin:0 auto 20px;background:var(--rose-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-check-circle text-success" style="font-size:2.5rem;"></i>
        </div>
        <h2>Đặt hàng thành công!</h2>
        <p class="text-muted">Cảm ơn bạn đã mua sắm tại BeautyStore.</p>
        <p>Mã đơn hàng: <strong class="text-rose fs-5">#@Model.Id</strong></p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="checkout-section">
                <h5 class="mb-3">Chi tiết đơn hàng</h5>
                <table class="table">
                    <tr>
                        <th>Trạng thái</th>
                        <td><span class="badge @Model.StatusBadgeClass">@Model.Status</span></td>
                    </tr>
                    <tr><th>Ngày đặt</th><td>@Model.FormattedDate</td></tr>
                    <tr><th>Người nhận</th><td>@Model.ReceiverName - @Model.PhoneNumber</td></tr>
                    <tr><th>Địa chỉ</th><td>@Model.FullAddress</td></tr>
                    <tr><th>Thanh toán</th><td>@Model.PaymentMethod</td></tr>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <tr><th>Ghi chú</th><td>@Model.Note</td></tr>
                    }
                </table>
                <hr />
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex align-items-center mb-3">
                        <img src="@item.PictureUri" class="rounded" style="width:50px;height:50px;object-fit:cover;margin-right:12px;"
                             onerror="this.src='/images/placeholder.png'" />
                        <div class="flex-grow-1">
                            <strong>@item.ProductName</strong>
                            <br /><small class="text-muted">SL: @item.Units × @item.FormattedPrice</small>
                        </div>
                        <strong>@item.FormattedSubtotal</strong>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between">
                    <strong class="fs-5">Tổng cộng</strong>
                    <strong class="fs-5 text-rose">@Model.FormattedTotal</strong>
                </div>
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-rose me-2">
                    <i class="fas fa-receipt me-2"></i>Xem đơn hàng
                </a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-rose">
                    <i class="fas fa-store me-2"></i>Tiếp tục mua sắm
                </a>
            </div>
        </div>
    </div>
</div>
