@model Cosmetics.Web.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-5">
    <h2 class="mb-4"><i class="fas fa-credit-card text-rose me-2"></i>Thanh toán</h2>

    <form asp-controller="Order" asp-action="PlaceOrder" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="checkout-section">
                    <h5 class="mb-4"><i class="fas fa-truck me-2 text-rose"></i>Thông tin giao hàng</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ tên người nhận <span class="text-danger">*</span></label>
                            <input asp-for="ReceiverName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="ReceiverName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Số nhà, Tên đường <span class="text-danger">*</span></label>
                            <input asp-for="Street" class="form-control" placeholder="123 Nguyễn Huệ" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Phường/Xã</label>
                            <input asp-for="Ward" class="form-control" placeholder="Phường Bến Nghé" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Quận/Huyện <span class="text-danger">*</span></label>
                            <input asp-for="District" class="form-control" placeholder="Quận 1" />
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                            <input asp-for="City" class="form-control" placeholder="TP. Hồ Chí Minh" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3"><i class="fas fa-wallet me-2 text-rose"></i>Phương thức thanh toán</h5>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="PaymentMethod" value="0" id="cod" checked />
                        <label class="form-check-label" for="cod">
                            <i class="fas fa-money-bill-wave me-2 text-success"></i>Thanh toán khi nhận hàng (COD)
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="PaymentMethod" value="1" id="bank" />
                        <label class="form-check-label" for="bank">
                            <i class="fas fa-university me-2 text-primary"></i>Chuyển khoản ngân hàng
                        </label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="PaymentMethod" value="2" id="vnpay" />
                        <label class="form-check-label" for="vnpay">
                            <i class="fas fa-qrcode me-2 text-info"></i>VNPay
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú cho đơn hàng (không bắt buộc)"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="checkout-section">
                    <h5 class="mb-3">Đơn hàng của bạn</h5>
                    <hr />
                    @if (Model.Basket != null)
                    {
                        @foreach (var item in Model.Basket.Items)
                        {
                            <div class="d-flex align-items-center mb-3">
                                <img src="@item.PictureUri" alt="@item.ProductName" class="rounded"
                                     style="width:50px;height:50px;object-fit:cover;margin-right:12px;"
                                     onerror="this.src='/images/placeholder.png'" />
                                <div class="flex-grow-1">
                                    <small class="fw-semibold">@item.ProductName</small>
                                    <br /><small class="text-muted">SL: @item.Quantity</small>
                                </div>
                                <strong class="small">@item.FormattedSubtotal</strong>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <strong>@Model.Basket.FormattedTotal</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Phí vận chuyển</span>
                            <span class="text-success fw-semibold">Miễn phí</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <strong class="fs-5">Tổng cộng</strong>
                            <strong class="fs-5 text-rose">@Model.Basket.FormattedTotal</strong>
                        </div>
                    }
                    <button type="submit" class="btn btn-rose w-100 btn-lg mt-4">
                        <i class="fas fa-check-circle me-2"></i>Đặt hàng
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
