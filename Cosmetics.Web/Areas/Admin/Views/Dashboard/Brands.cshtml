@model IReadOnlyList<CatalogBrand>
@{
    ViewData["Title"] = "Quản lý Thương hiệu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Thương hiệu Mỹ phẩm</h3>
        <p class="text-muted mb-0">Các hãng mỹ phẩm chính hãng đối tác trên hệ thống</p>
    </div>
    <a asp-action="CreateBrand" class="btn btn-rose rounded-pill px-3 shadow-sm">
        <i class="fas fa-plus me-1"></i> Thêm thương hiệu
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">Logo</th>
                    <th>Tên thương hiệu</th>
                    <th>Xuất xứ</th>
                    <th>Mô tả</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var brand in Model)
                    {
                        <tr>
                            <td>
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-award text-rose fs-5"></i>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@brand.Name</div>
                                <small class="text-muted">ID: #@brand.Id</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fas fa-globe-americas me-1 text-muted"></i>@(string.IsNullOrEmpty(brand.CountryOfOrigin) ? "Không rõ" : brand.CountryOfOrigin)
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">@brand.Description</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            Chưa có thương hiệu nào. Hãy bấm "Thêm thương hiệu" để bắt đầu.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
