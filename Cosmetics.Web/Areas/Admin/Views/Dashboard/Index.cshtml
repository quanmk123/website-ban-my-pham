@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
    var lowStockItems = ViewBag.LowStockItems as List<CatalogItem> ?? new List<CatalogItem>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Tổng quan Cửa hàng</h3>
        <p class="text-muted mb-0">Theo dõi doanh thu, số lượng đơn hàng và tình trạng kho mỹ phẩm</p>
    </div>
    <div>
        <a asp-action="CreateProduct" class="btn btn-rose rounded-pill px-3 shadow-sm">
            <i class="fas fa-plus me-1"></i> Thêm sản phẩm mới
        </a>
    </div>
</div>

<!-- STATS CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Doanh thu hoàn thành</span>
                    <h3 class="fw-bold text-success mb-0 mt-2">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) ₫</h3>
                </div>
                <div class="rounded-circle bg-success-subtle text-success p-3">
                    <i class="fas fa-coins fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng số đơn hàng</span>
                    <h3 class="fw-bold text-primary mb-0 mt-2">@ViewBag.TotalOrders</h3>
                    <small class="text-muted">Đã xong: @ViewBag.CompletedOrders</small>
                </div>
                <div class="rounded-circle bg-primary-subtle text-primary p-3">
                    <i class="fas fa-receipt fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Đơn chờ xác nhận</span>
                    <h3 class="fw-bold text-warning mb-0 mt-2">@ViewBag.PendingOrders</h3>
                    <a asp-action="Orders" asp-route-status="Pending" class="small text-warning text-decoration-none">Xem chi tiết &rarr;</a>
                </div>
                <div class="rounded-circle bg-warning-subtle text-warning p-3">
                    <i class="fas fa-clock fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng số sản phẩm</span>
                    <h3 class="fw-bold text-dark mb-0 mt-2">@ViewBag.TotalProducts</h3>
                    <small class="text-danger">Sắp hết hàng: @ViewBag.LowStockProducts</small>
                </div>
                <div class="rounded-circle bg-rose-subtle text-rose p-3">
                    <i class="fas fa-pump-soap fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- LOW STOCK ALERT & QUICK ACTIONS -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>Cảnh báo tồn kho thấp (dưới 5 sản phẩm)
                </h5>
                <span class="badge bg-danger rounded-pill">@lowStockItems.Count mặt hàng</span>
            </div>
            <div class="card-body p-0">
                @if (lowStockItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Giá bán</th>
                                    <th>Tồn kho</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in lowStockItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.PictureUri) ? "/images/placeholder.png" : item.PictureUri)" 
                                                     alt="@item.Name" class="rounded me-3" style="width: 44px; height: 44px; object-fit: cover;" />
                                                <div>
                                                    <div class="fw-semibold text-dark">@item.Name</div>
                                                    <small class="text-muted">Mã: #@item.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@item.Price.ToString("N0") ₫</td>
                                        <td>
                                            <span class="badge bg-danger">@item.StockQuantity chiếc</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="fas fa-edit me-1"></i>Nhập thêm
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-check-circle text-success fs-1 mb-2"></i>
                        <p class="mb-0">Kho hàng đang ở trạng thái an toàn. Không có sản phẩm nào sắp hết hàng!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-bolt text-warning me-2"></i>Lối tắt tác vụ nhanh</h5>
            <div class="d-grid gap-2">
                <a asp-action="CreateProduct" class="btn btn-outline-rose text-start py-2 rounded-3">
                    <i class="fas fa-box-open me-2 text-rose"></i> Thêm sản phẩm mỹ phẩm
                </a>
                <a asp-action="Orders" class="btn btn-outline-primary text-start py-2 rounded-3">
                    <i class="fas fa-receipt me-2 text-primary"></i> Xem danh sách đơn hàng
                </a>
                <a asp-action="CreateBrand" class="btn btn-outline-secondary text-start py-2 rounded-3">
                    <i class="fas fa-award me-2 text-secondary"></i> Thêm thương hiệu mới
                </a>
                <a asp-action="CreateType" class="btn btn-outline-dark text-start py-2 rounded-3">
                    <i class="fas fa-tags me-2 text-dark"></i> Thêm danh mục loại mới
                </a>
            </div>
        </div>
    </div>
</div>
