@model CatalogType
@{
    ViewData["Title"] = "Thêm Danh mục Mới";
}

<div class="mb-4">
    <a asp-action="Types" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-dark"><i class="fas fa-tags text-rose me-2"></i>Thêm Danh mục Mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateType" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger rounded-3" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control rounded-3" placeholder="Ví dụ: Kem chống nắng, Serum dưỡng da..." required autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Mô tả danh mục</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Mô tả công dụng hoặc các đặc trưng của danh mục mỹ phẩm này..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Types" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-rose rounded-3 px-4 fw-semibold">
                            <i class="fas fa-save me-1"></i> Lưu danh mục
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
